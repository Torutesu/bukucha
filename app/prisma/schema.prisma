generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // ランタイム(本番はNeonのpooled URL)
  directUrl = env("DIRECT_URL") // migrate用の直結URL(ローカルはDATABASE_URLと同値)
}

// ============ enums ============

enum ContentLevel {
  ALL_AGES
  R15
  R18 // MVP未使用。派生用に予約
}

enum SituationStatus {
  DRAFT
  PUBLISHED
  PRIVATE
  SUSPENDED
}

enum StoryStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  AI
  SYSTEM
}

enum ModerationKind {
  IP_DETECTED
  CONTENT_OVER_LINE
  BANNED_EXPRESSION
}

enum ModerationStatus {
  FLAGGED
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum UserStatus {
  ACTIVE
  BANNED
}

// ============ User / Auth ============

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  nickname       String
  avatarUrl      String?
  birthDate      DateTime?
  safeFilterOff  Boolean   @default(false)
  preferenceTags String[]
  // AIF-008 返信候補の日次クォータ(50回/日、朝9時JSTリセット)
  suggestDate    String?
  suggestUsed    Int        @default(0)
  // Zeta型プロフィール: ID(@handle)・自己紹介・規約同意日時
  handle         String?    @unique
  bio            String?
  agreedAt       DateTime?
  isCreatorBadge Boolean    @default(false)
  role           String     @default("USER")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts   AuthAccount[]
  personas   Persona[]
  situations Situation[]
  stories    Story[]
  likes      Like[]
  reports    Report[]
}

model AuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Persona {
  id        String  @id @default(cuid())
  userId    String
  name      String
  callName  String?
  profile   String?
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories   Story[]
}

// ============ Situation ============

model Situation {
  id            String          @id @default(cuid())
  authorId      String
  title         String
  catchphrase   String          @default("")
  worldSetting  String          @default("")
  coverImageUrl String?
  contentLevel  ContentLevel    @default(ALL_AGES)
  status        SituationStatus @default(DRAFT)
  aiDraftInput  String?
  // Zeta型プロット設定: スタイル(視点/時制/長さ/雰囲気ほか)・設定集(キーワード連動)・紹介/コメント
  style           Json     @default("{}")
  lore            Json     @default("[]")
  commentsEnabled Boolean  @default(true)
  creatorComment  String?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  likeCount   Int @default(0)
  storyCount  Int @default(0)
  readerCount Int @default(0)

  author     User             @relation(fields: [authorId], references: [id])
  characters Character[]
  intros     IntroVariant[]
  tags       SituationTag[]
  stories    Story[]
  likes      Like[]
  flags      ModerationFlag[]

  @@index([status, contentLevel, publishedAt])
  @@index([authorId])
}

model Character {
  id              String    @id @default(cuid())
  situationId     String
  name            String
  profileImageUrl String?
  personality     String    @default("")
  speechStyle     String    @default("")
  relationship    String    @default("")
  exampleDialogs  Json      @default("[]")
  sortOrder       Int       @default(0)
  situation       Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
}

model IntroVariant {
  id           String    @id @default(cuid())
  situationId  String
  label        String
  introText    String    @default("")
  firstMessage String    @default("")
  sortOrder    Int       @default(0)
  situation    Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  stories      Story[]
}

model Tag {
  id         String         @id @default(cuid())
  name       String         @unique
  category   String
  isR15      Boolean        @default(false)
  situations SituationTag[]
}

model SituationTag {
  situationId String
  tagId       String
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([situationId, tagId])
}

// ============ Story ============

model Story {
  id                  String      @id @default(cuid())
  userId              String
  situationId         String
  introVariantId      String
  personaId           String?
  status              StoryStatus @default(ACTIVE)
  choicesEnabled      Boolean     @default(true)
  useMidModel         Boolean     @default(false)
  lastRecap           String?
  lastRecapAtIdx      Int         @default(0)
  branchedFromStoryId String?
  lastMessageAt       DateTime    @default(now())
  createdAt           DateTime    @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  situation    Situation      @relation(fields: [situationId], references: [id])
  introVariant IntroVariant   @relation(fields: [introVariantId], references: [id])
  persona      Persona?       @relation(fields: [personaId], references: [id])
  messages     StoryMessage[]
  memory       StoryMemory?

  @@index([userId, lastMessageAt])
}

model StoryMessage {
  id             String      @id @default(cuid())
  storyId        String
  idx            Int
  role           MessageRole
  // USERメッセージの種別: SAY(セリフ) / ACTION(動作・地の文) / DIRECTION(作者としての展開指示)
  kind           String      @default("SAY")
  content        String
  choices        Json?
  selectedChoice String?
  isDeleted      Boolean     @default(false)
  modelUsed      String?
  createdAt      DateTime    @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, idx])
}

model StoryMemory {
  storyId      String @id
  summary      String @default("")
  summaryAtIdx Int    @default(0)
  userNote     String @default("")
  story        Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

// ============ Social ============

model Like {
  userId      String
  situationId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@id([userId, situationId])
}

// ============ Trust & Safety ============

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  targetType     String
  targetId       String
  reason         String
  detail         String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  reporter       User         @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
}

model ModerationFlag {
  id           String           @id @default(cuid())
  situationId  String?
  targetType   String
  targetId     String
  kind         ModerationKind
  detail       String
  status       ModerationStatus @default(FLAGGED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime         @default(now())
  situation    Situation?       @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/** 運営操作の監査証跡。人間/AIエージェントどちらの操作も記録する */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}
