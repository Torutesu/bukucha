{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && npm run db:seed && npm run db:sync-content && next build",
    "db:sync-content": "tsx prisma/sync-content.ts",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "shots": "playwright test --config=playwright.shots.config.ts",
    "test:seo": "playwright test --config=playwright.seo.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vercel": "^58.11.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
